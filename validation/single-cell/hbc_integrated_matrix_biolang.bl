# Isolate BioLang's integration correction using Seurat's scored anchors and
# exact query weighting PCA over byte-identical SCT residual matrices.

let input_dir = env("BIOLANG_HBC_CCA_INPUT")
let anchor_dir = env("BIOLANG_HBC_CCA_ORACLE")
let oracle_dir = env("BIOLANG_HBC_INTEGRATION_ORACLE")
let output_dir = env("BIOLANG_HBC_CCA_OUTPUT")
if input_dir == nil or anchor_dir == nil or oracle_dir == nil or output_dir == nil {
    error("set BIOLANG_HBC_CCA_INPUT, BIOLANG_HBC_CCA_ORACLE, BIOLANG_HBC_INTEGRATION_ORACLE, and BIOLANG_HBC_CCA_OUTPUT")
}

let left = read_f64_matrix(input_dir + "/ctrl.f64")
let right = read_f64_matrix(input_dir + "/stim.f64")
let anchor_table = read_csv(anchor_dir + "/anchors.csv")
let anchor_left = col(anchor_table, "left")
let anchor_right = col(anchor_table, "right")
let anchor_score = col(anchor_table, "score")
let anchors = range(0, len(anchor_left)) |> map(|index| ({
    left: anchor_left[index],
    right: anchor_right[index],
    score: anchor_score[index]
}))
let pc_columns = range(1, 31) |> map(|index| "PC_" + str(index))
let weight_reduction = matrix_from_table(
    read_csv(oracle_dir + "/query-weight-pca.csv"), pc_columns
)
let diagnostic_cells = range(0, 512) |> map(|index| index * 28)

let started = timestamp_ms()
let result = sc_integrate_anchors(left, right, {anchors: anchors, dims: 30}, {
    k_weight: 100,
    sd_weight: 1.0,
    weight_reduction: weight_reduction,
    return_details: true,
    diagnostic_weight_cells: diagnostic_cells
})
let elapsed = float(timestamp_ms() - started) / 1000.0

# A deterministic grid spans the whole query and feature axes while keeping
# the neutral comparison artifact compact enough for review.
let query_rows = range(0, 512) |> map(|index| dim(left)[0] + index * 28)
let feature_columns = range(0, 500) |> map(|index| index * 6)
let sample = select_cols(
    select_rows(result.integrated_matrix, query_rows),
    feature_columns
)
write_csv(matrix_to_table(matrix(sample)), output_dir + "/integrated-query-sample.csv")
write_csv(table(result.diagnostic_weights), output_dir + "/integration-weights.csv")
write_csv(table([{
    query_cells: dim(right)[0],
    features: dim(right)[1],
    anchors: len(anchors),
    k_weight: 100,
    effective_k: result.effective_k,
    elapsed_seconds: elapsed
}]), output_dir + "/integration-summary.csv")
println("HBC_INTEGRATED_MATRIX_BIOLANG_OK seconds=" + str(round(elapsed, 3)))
